    kall(9674) = 1.000e-09*Gnot*exp(-1.700e+00*variable_Av)

    !C7H4_gas -> C7H2_gas + H2_gas (gasphase_Av)
    kall(9675) = 1.000e-09*Gnot*exp(-1.700e+00*variable_Av)

    !C8H4_gas -> C8H2_gas + H2_gas (gasphase_Av)
    kall(9676) = 1.000e-09*Gnot*exp(-1.700e+00*variable_Av)

    !C9H4_gas -> C9H2_gas + H2_gas (gasphase_Av)
    kall(9677) = 1.000e-09*Gnot*exp(-1.700e+00*variable_Av)

    !P+_gas + E_gas -> P_gas (gasphase)
    kall(9678) = 4.000e-12*(variable_Tgas/3d2)**(-6.000e-01)

    !HC6N+_gas + E_gas -> CN_gas + C5H_gas (gasphase)
    kall(9679) = 1.000e-07*(variable_Tgas/3d2)**(-5.000e-01)

    !HC6N+_gas + E_gas -> H_gas + C6N_gas (gasphase)
    kall(9680) = 1.000e-07*(variable_Tgas/3d2)**(-5.000e-01)

    !HC8N+_gas + E_gas -> CN_gas + C7H_gas (gasphase)
    kall(9681) = 1.000e-07*(variable_Tgas/3d2)**(-5.000e-01)

    !HC8N+_gas + E_gas -> H_gas + C8N_gas (gasphase)
    kall(9682) = 1.000e-07*(variable_Tgas/3d2)**(-5.000e-01)

    !HC10N+_gas + E_gas -> CN_gas + C9H_gas (gasphase)
    kall(9683) = 1.000e-07*(variable_Tgas/3d2)**(-5.000e-01)

    !HC10N+_gas + E_gas -> H_gas + C10N_gas (gasphase)
    kall(9684) = 1.000e-07*(variable_Tgas/3d2)**(-5.000e-01)

    !GRAIN-_gas + Cl+_gas -> GRAIN0_gas + Cl_gas (gasphase)
    kall(9685) = 1.300e-05* 1d0/sqrt(3.50000000d+01) * kgr_ion

    !GRAIN-_gas + F+_gas -> GRAIN0_gas + F_gas (gasphase)
    kall(9686) = 1.800e-05* 1d0/sqrt(1.90000000d+01) * kgr_ion

    ! <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
    !!END_RATES


  end subroutine computeGasRates


end module kemimo_gas_rates
